{
  "name": "dropship-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Store-agnostic AliExpress dropshipping engine: product import, margin pricing, order fulfillment, tracking sync. REST API + webhooks — any storefront connects via a thin adapter, not a shared database.",
  "type": "module",
  "main": "src/api/server.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "worker": "node --import tsx src/worker/index.ts",
    "create-store": "node --import tsx src/cli/create-store.ts",
    "sync:catalog": "node --import tsx src/cli/sync-catalog.ts",
    "sync:tracking": "node --import tsx src/cli/sync-tracking.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "bullmq": "^5.22.0",
    "fastify": "^4.28.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
