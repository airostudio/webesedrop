# The engine's own Supabase project — NOT the storefront's. Apply
# supabase/schema.sql to a fresh project before running anything.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

PORT=3100

# Required only for the scheduled worker (apps that just call the CLI
# one-off scripts, pnpm sync:catalog / sync:tracking, don't need it).
REDIS_URL=

# Bearer key for the operator-only /v1/admin/* API (billing/accounting,
# the domain install log, reports) — see src/auth/adminAuth.ts. Not a store
# API key; generate your own long random value.
ADMIN_API_KEY=

# The engine's own Stripe account — bills connected stores for using the
# engine (subscriptions/plans), entirely separate from AliExpress order
# money. Required for /v1/billing/* and the admin's billing reports.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The engine's own AliExpress Open Platform app (from open.aliexpress.com —
# register one app for the whole platform, add every storefront's OAuth
# redirect URI to it). With this set, a connecting store just visits the
# authorize URL and logs into their own AliExpress account — no per-store
# app registration needed. A store can still register its own app via
# POST /v1/aliexpress/connection if it wants to (e.g. for its own API
# rate limits), which overrides this for that store only.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# Optional — enables AI-written product copy (SEO title + on-brand description) on
# POST /v1/products/import via Claude (see src/copy/claudeProvider.ts). Without this set,
# imports still work — they fall back to the offline template rewriter automatically.
ANTHROPIC_API_KEY=
